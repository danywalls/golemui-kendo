import { Component } from '@angular/core';
import type { FormSubmitEvent } from '@golemui/core';
import { kendo, type KendoFormInitConfig } from 'golemui-kendo';
import { KendoFormComponent } from '<%= widgetsImportPath %>/kendo-form.component';

// The form is a plain array of `kendo.*` builder calls. Labels and placeholders
// are derived from the data path unless you set them.
const exampleFormDef = [
  kendo.layouts.row([
    kendo.inputs.textBox('firstName', { validator: { required: true } }),
    kendo.inputs.textBox('lastName', { validator: { required: true } }),
  ]),
  kendo.inputs.textBox('email', {
    label: 'Email address',
    placeholder: 'you@example.com',
    clearButton: true,
    validator: { required: true, format: 'email' },
  }),
  kendo.inputs.passwordBox('password', {
    hint: 'At least 8 characters',
    validator: { required: true, minLength: 8 },
  }),
  kendo.inputs.numericTextBox('age', {
    min: 18,
    max: 120,
    validator: { required: true, min: 18 },
  }),
  kendo.inputs.dropDownList('country', {
    defaultItem: 'Pick a country',
    options: [
      { text: 'Spain', value: 'es' },
      { text: 'Ireland', value: 'ie' },
      { text: 'Argentina', value: 'ar' },
    ],
    validator: { required: true },
  }),
  kendo.inputs.datePicker('startDate', { label: 'Start date' }),
  kendo.inputs.textArea('bio', { placeholder: 'Tell us about yourself...', rows: 3 }),
  kendo.inputs.switch('newsletter', { label: 'Subscribe to the newsletter', onLabel: 'YES', offLabel: 'NO' }),
  kendo.inputs.checkbox('rememberMe', { label: 'Remember me on this device' }),

  kendo.actions.submitButton({ label: 'Create account', disabled: { when: '$formIsInvalid' } }),
];

// Selectors decorate widgets after the fact, by type, tag, or uid.
const exampleSelectors = [kendo.selectors.inputs({ override: { kuiSize: 'medium' } })];

@Component({
  selector: 'app-example-form',
  imports: [KendoFormComponent],
  template: `
    <h2>GolemUI + Kendo UI example form</h2>
    <kendo-form [config]="config" (formSubmit)="onFormSubmit($event)"></kendo-form>
  `,
})
export class ExampleFormComponent {
  protected config: KendoFormInitConfig = {
    formDef: exampleFormDef,
    formSelectors: exampleSelectors,
    data: { country: 'es' },
  };

  protected onFormSubmit(event: FormSubmitEvent) {
    console.log('Form submitted:', event.data);
  }
}
